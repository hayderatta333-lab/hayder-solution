# Copy this file's contents into real environment variables on your server.
# Never commit real secrets to GitHub.

SECRET_KEY=change-this-to-a-random-secret-string

# Email (optional - for Send Email feature)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password

# WhatsApp via Twilio (optional - for Phase 2 chat features)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AI Auto-Reply (optional - Anthropic API for automatic WhatsApp replies)
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_AUTO_REPLY_ENABLED=false
